rules_version = '2';

// Storage rules companion to firestore.rules. Source of truth: same plan
// section referenced there ("0.5 보안 규칙" in
// .omc/plans/how-to-use-arduino-implementation.md).
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /wiring/{f} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
