rules_version = '2';

// Security rules for the "검증 원장" (verification ledger) architecture.
// Source of truth for this text: .omc/plans/how-to-use-arduino-implementation.md
// section "0.5 보안 규칙 + App Check + CI 아이덴티티" (A6.4, PL2).
// Do not hand-edit without updating the plan file first — this is a
// transcription, not an independent design.
service cloud.firestore {
  match /databases/{database}/documents {
    // isAdmin()/isCI() MUST guard on request.auth != null before dereferencing
    // request.auth.token — an absent request.auth (fully unauthenticated
    // request) must short-circuit to `false` instead of erroring. See PL2 ⑨.
    function isAdmin() {
      return request.auth != null
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isCI() {
      return request.auth != null
        && 'ci' in request.auth.token
        && request.auth.token.ci == true;
    }

    // Payload schema for the fire-and-forget public `events` writes (A5.8).
    // Rules can only validate shape, not rate — App Check covers the rest.
    function validEventPayload() {
      let data = request.resource.data;
      let allowedKeys = ['anonId', 'recipeId', 'event', 'step', 'tokens', 'at'];
      let requiredKeys = ['anonId', 'recipeId', 'event', 'at'];
      return data.keys().hasOnly(allowedKeys)
        && data.keys().hasAll(requiredKeys)
        && data.anonId is string && data.anonId.size() <= 64
        && data.recipeId is string && data.recipeId.size() <= 128
        && data.event is string
        && data.event in ['start', 'step_check', 'complete', 'search_fail']
        && data.at is timestamp
        && (
          (data.event == 'search_fail' && 'tokens' in data && !('step' in data))
          || (data.event == 'step_check' && 'step' in data && !('tokens' in data))
          || (data.event in ['start', 'complete'] && !('step' in data) && !('tokens' in data))
        )
        && (!('step' in data) || (data.step is number && data.step >= 0 && data.step % 1 == 0))
        && (!('tokens' in data) || validSearchTokens(data.tokens));
    }

    function validSearchTokens(tokens) {
      return tokens is list
        && tokens.size() > 0
        && tokens.size() <= 20
        && (tokens.size() <= 0 || (tokens[0] is string && tokens[0].size() <= 48 && tokens[0].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 1 || (tokens[1] is string && tokens[1].size() <= 48 && tokens[1].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 2 || (tokens[2] is string && tokens[2].size() <= 48 && tokens[2].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 3 || (tokens[3] is string && tokens[3].size() <= 48 && tokens[3].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 4 || (tokens[4] is string && tokens[4].size() <= 48 && tokens[4].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 5 || (tokens[5] is string && tokens[5].size() <= 48 && tokens[5].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 6 || (tokens[6] is string && tokens[6].size() <= 48 && tokens[6].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 7 || (tokens[7] is string && tokens[7].size() <= 48 && tokens[7].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 8 || (tokens[8] is string && tokens[8].size() <= 48 && tokens[8].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 9 || (tokens[9] is string && tokens[9].size() <= 48 && tokens[9].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 10 || (tokens[10] is string && tokens[10].size() <= 48 && tokens[10].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 11 || (tokens[11] is string && tokens[11].size() <= 48 && tokens[11].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 12 || (tokens[12] is string && tokens[12].size() <= 48 && tokens[12].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 13 || (tokens[13] is string && tokens[13].size() <= 48 && tokens[13].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 14 || (tokens[14] is string && tokens[14].size() <= 48 && tokens[14].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 15 || (tokens[15] is string && tokens[15].size() <= 48 && tokens[15].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 16 || (tokens[16] is string && tokens[16].size() <= 48 && tokens[16].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 17 || (tokens[17] is string && tokens[17].size() <= 48 && tokens[17].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 18 || (tokens[18] is string && tokens[18].size() <= 48 && tokens[18].matches('^[가-힣a-z0-9]+$')))
        && (tokens.size() <= 19 || (tokens[19] is string && tokens[19].size() <= 48 && tokens[19].matches('^[가-힣a-z0-9]+$')));
    }

    match /recipes/{id} {
      allow read: if resource.data.status == 'published'
                  || isAdmin() || isCI();      // ← N6
      allow write: if isAdmin();

      match /versions/{versionId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /sensors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sensorRationales/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /simStatus/{recipeId} {
      allow read: if true;
      allow write: if isCI();
    }

    match /stats/{recipeId} {
      allow read: if isAdmin();
      allow write: if isCI();
    }

    match /searchStats/{doc} {
      allow read: if isAdmin();
      allow write: if isCI();
    }

    // Private state for exact, incremental stats aggregation. Keeping this
    // separate prevents anonymous identifiers and cursors from entering the
    // teacher-facing stats documents.
    match /statsSessions/{sessionId} {
      allow read, write: if isCI();
    }

    match /aggregationMeta/{doc} {
      allow read, write: if isCI();
    }

    match /verifyRequests/{id} {
      allow create: if isAdmin();
      allow read, delete: if isCI();           // ← E3 큐
    }

    match /events/{id} {
      allow create: if validEventPayload();
      allow read: if isAdmin() || isCI();       // ← E1 크론 집계
      allow update, delete: if false;
    }
  }
}
