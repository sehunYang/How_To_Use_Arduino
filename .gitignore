# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env / secrets — Firebase web config is public-by-design but keep local
# overrides (emulator toggles, VITE_BASE_PATH for local testing) untracked
.env
.env.local

# Firebase emulator + CLI artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
storage-debug.log

# 도구가 남기는 세션 기록과 스캔 캐시. 세션 파일은 session_id와 끝난 시각,
# 모드 이름만 든 213바이트짜리라 프로젝트에 대해 아무 말도 하지 않고,
# project-memory.json은 도구가 트리를 훑을 때마다 다시 씁니다. 사람이 적는
# 칸이 채워지기 전까지는 커밋할 내용이 없습니다. 판단이 적힌 글은
# .omc/plans/와 .omc/specs/에 있고 그쪽은 계속 추적합니다.
**/.omc/sessions/
**/.omc/project-memory.json
**/.omc/.*.tmp.*

# Ralph session-scoped runtime state (progress logs, prd.json working copy).
# 도구가 작업 디렉터리를 따라 `src/data/.omc/`처럼 아무 데나 만들기도 하므로
# 뿌리에 붙은 것만이 아니라 어느 깊이에서든 무시합니다.
**/.omc/state/

# Project-local toolchain: the arduino-cli binary, the arduino:avr core,
# installed libraries and staged .ino sketch folders (see
# scripts/setup-arduino-cli.ts). Downloaded on demand, never committed.
.tools/

# CI-generated verification artifacts (scripts/extract-content.ts, US-202):
# regenerated from Firestore recipes on every run, not committed source.
/sketches/
/diagram/

# Build artefacts staged into the self-contained chip-conformance Wokwi project
# by scripts/build-wokwi-firmware.ts (wokwi.toml paths must stay project-local).
# The .wasm sources live in chips/ and ARE committed; these are copies.
/wokwi/chip-conformance/firmware.*
/wokwi/chip-conformance/*.chip.wasm
/wokwi/chip-conformance/*.chip.json
/wokwi/ina219-current/firmware.*
/wokwi/ina219-current/*.chip.wasm
/wokwi/ina219-current/*.chip.json
/wokwi/phase5/*/firmware.*
/wokwi/phase5/*/*.chip.wasm
/wokwi/phase5/*/*.chip.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
