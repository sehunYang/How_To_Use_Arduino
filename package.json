{
  "name": "how-to-use-arduino",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/generate-phase5-wiring.ts && tsx scripts/generate-student-index.ts && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project how-to-use-arduino-test --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "verify:spa-fallback": "node scripts/verify-spa-fallback.mjs",
    "verify:bundle": "tsx scripts/verify-bundle-size.mjs",
    "setup:arduino-cli": "tsx scripts/setup-arduino-cli.ts",
    "verify:compile": "tsx scripts/verify-compile.ts",
    "verify:matching": "tsx scripts/verify-matching.ts",
    "verify:holdout": "tsx scripts/verify-holdout.ts",
    "verify:index": "tsx scripts/verify-student-index.ts",
    "verify:corpus": "tsx scripts/verify-corpus.ts",
    "verify:search-performance": "tsx scripts/verify-search-performance.ts",
    "aggregate:stats": "tsx scripts/aggregate-stats.ts",
    "seed:phase5": "tsx scripts/seed-phase5.ts",
    "verify:extract": "tsx scripts/extract-content.ts",
    "verify:queue": "tsx scripts/drain-verify-queue.ts",
    "build:wokwi": "tsx scripts/build-wokwi-firmware.ts",
    "generate:wokwi-diagram": "tsx scripts/generate-wokwi-diagram.ts",
    "generate:phase5-wiring": "tsx scripts/generate-phase5-wiring.ts",
    "verify:wokwi-diagram": "tsx scripts/generate-wokwi-diagram.ts --check",
    "test:wokwi-layout": "vitest run src/wokwi",
    "build:wokwi:chips": "wokwi-cli chip compile chips/ina219.chip.c chips/ina219.c -o chips/ina219.chip.wasm && wokwi-cli chip compile chips/tsl2591.chip.c chips/tsl2591.c -o chips/tsl2591.chip.wasm && wokwi-cli chip compile chips/bme280.chip.c chips/bme280.c -o chips/bme280.chip.wasm",
    "setup:zig": "node scripts/setup-zig.mjs",
    "verify:logic": "node scripts/verify-logic.mjs"
  },
  "dependencies": {
    "@wokwi/elements": "^1.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^13.29.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.1.1",
    "vitest": "^2.1.8"
  }
}
